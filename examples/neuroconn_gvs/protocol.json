{
  "protocol_version": "1.0",
  "name": "neuroconn_gvs_nirs",
  "loop": 1,
  "lsl": {
    "enabled": true,
    "stream_name": "Trigger",
    "stream_type": "Markers",
    "channel_count": 1,
    "channel_format": "int32",
    "source_id": "the_kit_gvs",
    "auto_markers": false
  },
  "ni_daq": {
    "enabled": true,
    "simulation_mode": false,
    "device": "Dev1",
    "channels": ["ao0", "ao1"],
    "rate": 400,
    "min_val": -10.0,
    "max_val": 10.0,
    "samps_per_chan": 800
  },
  "nodes": [
    {
      "id": "consignes",
      "type": "instructions",
      "engine": "qt",
      "params": {
        "text": "GVS NeuroConn + fNIRS\n\nIndiquez la direction perçue avec les flèches (↑ avant, ↓ arrière, ← gauche, → droite).\nManette Switch ou clavier.",
        "duration_s": 8,
        "key": "space"
      }
    },
    {
      "id": "gvs_block",
      "type": "neuroconn_gvs",
      "engine": "pygame",
      "params": {
        "amplitude": 1.2,
        "repetitions_per_condition": 10,
        "rise_s": 3.0,
        "plateau_s": 4.0,
        "fall_s": 3.0,
        "iti_base_s": 10.0,
        "iti_jitter_s": [1.0, 5.0],
        "random_seed": 42
      }
    }
  ]
}
