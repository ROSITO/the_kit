{
  "protocol_version": "1.0",
  "name": "neuroconn_gvs_dryrun",
  "loop": 1,
  "audio_defaults": {
    "timing_mode": "low_latency",
    "backend": "auto",
    "blocksize": 128
  },
  "lsl": {
    "enabled": true,
    "stream_name": "Trigger",
    "stream_type": "Markers",
    "channel_count": 1,
    "channel_format": "int32",
    "source_id": "the_kit_gvs_dryrun",
    "auto_markers": false
  },
  "ni_daq": {
    "enabled": true,
    "simulation_mode": true,
    "device": "Dev1",
    "channels": ["ao0", "ao1"],
    "rate": 400
  },
  "nodes": [
    {
      "id": "consignes",
      "type": "instructions",
      "engine": "qt",
      "params": {
        "text": "Dry-run GVS — 10 essais (2×5). Flèches clavier/manette.",
        "duration_s": 2,
        "key": "space"
      }
    },
    {
      "id": "gvs_block",
      "type": "neuroconn_gvs",
      "engine": "pygame",
      "params": {
        "amplitude": 1.2,
        "repetitions_per_condition": 2,
        "rise_s": 3.0,
        "plateau_s": 4.0,
        "fall_s": 3.0,
        "baseline_s": 3.0,
        "response_window_s": 5.0,
        "iti_base_s": 1.0,
        "iti_jitter_s": [0.0, 0.5],
        "random_seed": 99,
        "sounds": {
          "debut_dexpe": "debut_dexpe.mp3",
          "vous_pouvez_repondre": "vous_pouvez_repondre.mp3",
          "votre_reponse": "Votre_reponse.mp3",
          "fin_du_temps": "fin_du_temps.mp3"
        }
      }
    }
  ]
}
