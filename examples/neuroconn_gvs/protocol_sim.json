{
  "protocol_version": "1.0",
  "name": "neuroconn_gvs_sim",
  "loop": 1,
  "audio_defaults": {
    "timing_mode": "low_latency",
    "backend": "pygame",
    "blocksize": 128
  },
  "lsl": {
    "enabled": false,
    "auto_markers": false
  },
  "ni_daq": {
    "enabled": true,
    "simulation_mode": true,
    "device": "Dev1",
    "channels": ["ao0", "ao1"],
    "rate": 400
  },
  "nodes": [
    {
      "id": "gvs_block",
      "type": "neuroconn_gvs",
      "engine": "pygame",
      "params": {
        "amplitude": 1.2,
        "repetitions_per_condition": 2,
        "conditions": ["AP", "CONTROL"],
        "rise_s": 0.1,
        "plateau_s": 0.1,
        "fall_s": 0.1,
        "baseline_s": 0.5,
        "response_window_s": 0.5,
        "iti_base_s": 0.2,
        "iti_jitter_s": [0.0, 0.1],
        "random_seed": 7,
        "auto_respond": true,
        "skip_sounds": true,
        "sounds": {
          "debut_dexpe": "debut_dexpe.mp3",
          "vous_pouvez_repondre": "vous_pouvez_repondre.mp3",
          "votre_reponse": "Votre_reponse.mp3",
          "fin_du_temps": "fin_du_temps.mp3"
        }
      }
    }
  ]
}
