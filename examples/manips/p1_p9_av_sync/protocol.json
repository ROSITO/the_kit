{
  "protocol_version": "1.0",
  "name": "manip_p1_p9_av_sync",
  "description": "P1-P9 — essai A/V low-latency (PortAudio / WASAPI).",
  "loop": 1,
  "audio_defaults": {
    "timing_mode": "low_latency",
    "blocksize": 128,
    "scheduling_lead_s": 0.3,
    "offset_ms": 0
  },
  "nodes": [
    {
      "id": "instr",
      "type": "instructions",
      "engine": "qt",
      "params": {
        "text": "Essai sync audio-vidéo (low_latency). Médias dans assets/.",
        "duration_s": 4
      }
    },
    {
      "id": "fix",
      "type": "fixation",
      "engine": "psychopy",
      "params": {
        "text": "+",
        "duration_s": 1.0
      }
    },
    {
      "id": "trial_av",
      "type": "av_sync",
      "engine": "psychopy",
      "timing_mode": "low_latency",
      "params": {
        "video": "assets/forward.mp4",
        "audio": "assets/tone.wav",
        "duration_s": 5
      }
    },
    {
      "id": "probe",
      "type": "photosonde_square",
      "engine": "psychopy",
      "params": {
        "duration_s": 0.05,
        "size_norm": 0.12
      }
    }
  ]
}
