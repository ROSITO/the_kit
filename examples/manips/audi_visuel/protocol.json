{
  "protocol_version": "1.0",
  "name": "manip_audi_visuel",
  "description": "audi_visuel — sync A/V standalone (proche P1-P9).",
  "loop": 1,
  "audio_defaults": {
    "timing_mode": "low_latency",
    "blocksize": 128
  },
  "nodes": [
    {
      "id": "instr",
      "type": "instructions",
      "engine": "qt",
      "params": {
        "text": "Protocole audi_visuel (stub).",
        "duration_s": 3
      }
    },
    {
      "id": "av",
      "type": "av_sync",
      "engine": "psychopy",
      "timing_mode": "low_latency",
      "params": {
        "video": "assets/video.mp4",
        "audio": "assets/audio.wav"
      }
    },
    {
      "id": "resp",
      "type": "keyboard_response",
      "engine": "pygame",
      "params": {
        "duration_s": 3,
        "prompt": "Réponse (espace)",
        "keys": [
          "space"
        ]
      }
    }
  ]
}
